function affiliateSearchAdmin_(u){return ['ADMIN','SUPER_ADMIN'].indexOf(String(u.Role))>=0}
function affiliateSearchText_(value){return String(value||'').trim().toLowerCase().replace(/\s+/g,' ')}
function searchAffiliates_(u,p){p=p||{};var admin=affiliateSearchAdmin_(u);if(!admin)requireRole_(u,['STAFF']);var query=affiliateSearchText_(p.query),limit=Math.max(1,Math.min(Number(p.limit)||25,50));if(query.length<2)return {items:[],query:query,limit:limit};var affiliates={},staff={},brands={},candidates=[];rows_('Affiliates').forEach(function(a){affiliates[String(a.Affiliate_ID)]=a});rows_('Staff_List').forEach(function(s){staff[String(s.Staff_ID)]=s});rows_('Brand_List').forEach(function(b){brands[String(b.Brand_ID)]=b});rows_('Assignments').forEach(function(asn){if(String(asn.Status)!=='ACTIVE')return;var affiliate=affiliates[String(asn.Affiliate_ID)],owner=staff[String(asn.Staff_ID)]||{};if(!affiliate)return;if(!admin&&String(asn.Staff_ID)!==String(u.Staff_ID))return;if(admin&&p.staffId&&String(asn.Staff_ID)!==String(p.staffId))return;if(admin&&p.teamId&&String(owner.Team)!==String(p.teamId))return;var brandId=String(asn.Brand_ID||affiliate.Brand_ID||'');if(admin&&p.brandId&&brandId!==String(p.brandId))return;var haystack=affiliateSearchText_([affiliate.Affiliate_ID,affiliate.Affiliate_Username,affiliate.Affiliate_Name,affiliate.Email,affiliate.Phone].join(' '));if(haystack.indexOf(query)<0)return;var username=affiliateSearchText_(affiliate.Affiliate_Username),brand=brands[brandId]||{};candidates.push({affiliateId:String(affiliate.Affiliate_ID),affiliateUsername:String(affiliate.Affiliate_Username||''),affiliateName:String(affiliate.Affiliate_Name||''),brandId:brandId,brandName:String(brand.Brand_Name||brand.Brand_Code||''),staffId:String(asn.Staff_ID),staffName:admin?String(owner.Display_Name||owner.Username||''):'',_rank:username===query?0:username.indexOf(query)===0?1:2})});candidates.sort(function(a,b){return a._rank-b._rank||a.affiliateUsername.localeCompare(b.affiliateUsername)||a.affiliateId.localeCompare(b.affiliateId)});return {items:candidates.slice(0,limit).map(function(x){delete x._rank;return x}),query:query,limit:limit}}
