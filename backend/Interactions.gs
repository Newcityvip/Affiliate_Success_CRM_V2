  var items=[];interactions.forEach(function(row){var item=enrich(row,'INTERACTION');if(item)items.push(item)});attempts.forEach(function(row){if(row.Work_ID&&interactionWork[String(row.Work_ID)])return;var item=enrich(row,'CONTACT_ATTEMPT');if(item)items.push(item)});items.sort(function(a,b){var at=a.timestamp?new Date(a.timestamp).getTime():0,bt=b.timestamp?new Date(b.timestamp).getTime():0;return bt-at||String(b.id).localeCompare(String(a.id))});var size=Math.max(1,Math.min(Number(p&&p.pageSize)||500,500)),page=Math.max(1,Number(p&&p.page)||1),start=(page-1)*size;return {items:items.slice(start,start+size),page:page,pageSize:size,total:items.length};
}
