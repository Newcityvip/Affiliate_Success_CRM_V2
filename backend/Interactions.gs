function interactionAdmin_(user){return ['ADMIN','SUPER_ADMIN'].indexOf(user.Role)>=0}
function interactionTime_(row,primary){return String(row[primary]||row.Created_At||'')}
function myInteractions_(user,p){
  var admin=interactionAdmin_(user),staffId=String(user.Staff_ID),assignments=rows_('Assignments'),affiliates=rows_('Affiliates'),brands=rows_('Brand_List'),staff=rows_('Staff_List'),interactions=rows_('Interactions'),attempts=rows_('Contact_Attempts'),activeByAffiliate={},affiliateById={},brandById={},staffById={},interactionWork={};
  assignments.forEach(function(a){if(a.Status!=='ACTIVE')return;var key=String(a.Affiliate_ID);if(admin||String(a.Staff_ID)===staffId)activeByAffiliate[key]=a});affiliates.forEach(function(a){affiliateById[String(a.Affiliate_ID)]=a});brands.forEach(function(b){brandById[String(b.Brand_ID)]=b});staff.forEach(function(s){staffById[String(s.Staff_ID)]=s});interactions.forEach(function(i){if(i.Work_ID)interactionWork[String(i.Work_ID)]=true});
