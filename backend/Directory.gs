function directoryAdmin_(user){return ['ADMIN','SUPER_ADMIN'].indexOf(user.Role)>=0}
function activeDirectoryWork_(status){return ['PENDING','IN_PROGRESS','OVERDUE'].indexOf(String(status))>=0}
function directoryMaps_(){var staff={},brands={},activeAssignments={},assignmentLists={},workByAffiliate={};rows_('Staff_List').forEach(function(s){staff[String(s.Staff_ID)]=s});rows_('Brand_List').forEach(function(b){brands[String(b.Brand_ID)]=b});rows_('Assignments').forEach(function(a){if(a.Status!=='ACTIVE')return;var key=String(a.Affiliate_ID);(assignmentLists[key]||(assignmentLists[key]=[])).push(a);if(!activeAssignments[key])activeAssignments[key]=a});rows_('Work_Items').forEach(function(w){if(!activeDirectoryWork_(w.Status))return;var key=String(w.Affiliate_ID);(workByAffiliate[key]||(workByAffiliate[key]=[])).push(w)});return {staff:staff,brands:brands,assignments:activeAssignments,assignmentLists:assignmentLists,work:workByAffiliate}}
function directoryRow_(affiliate,maps,scopeStaffId){var id=String(affiliate.Affiliate_ID),assignment=(scopeStaffId&&(maps.assignmentLists[id]||[]).filter(function(a){return String(a.Staff_ID)===String(scopeStaffId)})[0])||maps.assignments[id]||{},staff=maps.staff[String(assignment.Staff_ID)]||{},brand=maps.brands[String(assignment.Brand_ID||affiliate.Brand_ID)]||{},work=(maps.work[id]||[]).filter(function(w){return !scopeStaffId||String(w.Staff_ID)===String(scopeStaffId)}).slice();work.sort(function(a,b){var ar=a.Due_At?new Date(a.Due_At).getTime():NaN,br=b.Due_At?new Date(b.Due_At).getTime():NaN,ad=isFinite(ar)?ar:Infinity,bd=isFinite(br)?br:Infinity;return ad-bd||String(a.Work_ID).localeCompare(String(b.Work_ID))});var current=work[0]||{};return {affiliateId:affiliate.Affiliate_ID,affiliateUsername:affiliate.Affiliate_Username,affiliateName:affiliate.Affiliate_Name||'',email:affiliate.Email||'',phone:affiliate.Phone||'',telegramUsername:affiliate.Telegram_Username||'',preferredChannel:affiliate.Preferred_Channel||'',brandId:brand.Brand_ID||affiliate.Brand_ID||'',brandName:brand.Brand_Name||'',brandCode:brand.Brand_Code||'',lifecycleStatus:affiliate.Lifecycle_Status||'',prospectStatus:affiliate.Prospect_Status||'',telegramStatus:affiliate.Telegram_Status||'',priority:affiliate.Priority||'',archiveStatus:affiliate.Archive_Status||'',assignedStaffId:assignment.Staff_ID||'',assignedStaffName:staff.Display_Name||staff.Username||'',assignmentId:assignment.Assignment_ID||'',lastContactAt:affiliate.Last_Contact_At||'',lastMeaningfulContactAt:affiliate.Last_Meaningful_Contact_At||'',activeWorkCount:work.length,currentWorkId:current.Work_ID||'',currentWorkType:current.Work_Type||'',currentWorkDueAt:current.Due_At||''}}
function affiliateDirectory_(user,p){var maps=directoryMaps_(),staffId=String(user.Staff_ID),admin=directoryAdmin_(user),all=rows_('Affiliates').filter(function(a){return admin||(maps.assignmentLists[String(a.Affiliate_ID)]||[]).some(function(x){return String(x.Staff_ID)===staffId})}).map(function(a){return directoryRow_(a,maps,admin?'':staffId)});all.sort(function(a,b){return String(a.affiliateUsername).localeCompare(String(b.affiliateUsername))});var size=Math.max(1,Math.min(Number(p&&p.pageSize)||500,500)),page=Math.max(1,Number(p&&p.page)||1),start=(page-1)*size,summary={totalAffiliates:all.length,telegramConnected:0,activeProspects:0,activeWork:0};all.forEach(function(a){if(a.telegramStatus==='CONNECTED'||a.lifecycleStatus==='TELEGRAM_CONNECTED')summary.telegramConnected++;if(['NEW','ACTIVE'].indexOf(a.prospectStatus)>=0&&a.archiveStatus!=='ARCHIVED')summary.activeProspects++;summary.activeWork+=a.activeWorkCount});return {items:all.slice(start,start+size),page:page,pageSize:size,total:all.length,summary:summary}}
function affiliateAccess_(user,affiliateId){var affiliate=rows_('Affiliates').filter(function(a){return String(a.Affiliate_ID)===String(affiliateId)})[0];if(!affiliate)throw apiError_('NOT_FOUND','Affiliate not found.');var assignments=rows_('Assignments').filter(function(a){return String(a.Affiliate_ID)===String(affiliateId)&&a.Status==='ACTIVE'}),assignment=assignments[0]||null;if(!directoryAdmin_(user)&&!assignments.some(function(a){return String(a.Staff_ID)===String(user.Staff_ID)}))throw apiError_('FORBIDDEN','Access denied.');return {affiliate:affiliate,assignment:assignment}}
function historyTime_(row,fields){for(var i=0;i<fields.length;i++)if(row[fields[i]])return String(row[fields[i]]);return ''}
function addRecentActivity_(events,event){var time=event.timestamp?new Date(event.timestamp).getTime():0,index=0;while(index<events.length){var current=events[index],currentTime=current.timestamp?new Date(current.timestamp).getTime():0;if(time>currentTime||time===currentTime&&String(event.id).localeCompare(String(current.id))>0)break;index++}events.splice(index,0,event);if(events.length>20)events.pop()}
function affiliateDetail_(user,p){var access=affiliateAccess_(user,p.affiliateId),maps=directoryMaps_(),profile=directoryRow_(access.affiliate,maps,directoryAdmin_(user)?'':String(user.Staff_ID)),id=String(access.affiliate.Affiliate_ID),events=[];rows_('Contact_Attempts').forEach(function(r){if(String(r.Affiliate_ID)===id)addRecentActivity_(events,{id:r.Attempt_ID,type:'CONTACT_ATTEMPT',timestamp:historyTime_(r,['Attempt_At','Created_At']),status:r.Result||'',channel:r.Channel||'',summary:r.Result_Detail||'',notes:r.Notes||''})});rows_('Interactions').forEach(function(r){if(String(r.Affiliate_ID)===id)addRecentActivity_(events,{id:r.Interaction_ID,type:'INTERACTION',timestamp:historyTime_(r,['Interaction_At','Created_At']),status:r.Outcome||r.Interaction_Type||'',channel:r.Channel||'',summary:r.Interaction_Type||'',notes:r.Notes||''})});rows_('Work_Items').forEach(function(r){if(String(r.Affiliate_ID)===id)addRecentActivity_(events,{id:r.Work_ID,type:'WORK_ITEM',timestamp:historyTime_(r,['Completed_At','Started_At','Assigned_At','Created_At']),status:r.Status||'',channel:r.Work_Channel||'',summary:r.Title||r.Work_Type||'',notes:r.Completion_Notes||''})});rows_('Followups').forEach(function(r){if(String(r.Affiliate_ID)===id)addRecentActivity_(events,{id:r.Followup_ID,type:'FOLLOWUP',timestamp:historyTime_(r,['Completed_At','Due_At','Created_At']),status:r.Status||'',channel:'',summary:r.Followup_Type||'',notes:r.Notes||''})});return {profile:profile,recentActivity:events}}
function workWorkspaceBootstrap_(user,p){var workspace=workWorkspace_(user,p);return {workspace:workspace,detail:affiliateDetail_(user,{affiliateId:workspace.work.affiliateId})}}
