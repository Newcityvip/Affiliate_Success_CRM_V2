  if(staff)valid=verifyPassword_(String(payload.password||''),staff.Password_Hash)&&staff.Status==='ACTIVE';else passwordHash_(String(payload.password||''),'00000000000000000000000000000000',25000);timing.passwordVerifyMs=Date.now()-stage;
  if(!valid){timing.totalLoginMs=Date.now()-totalStart;console.log(JSON.stringify({event:'login_timing',requestId:payload.requestId,success:false,timing:timing}));cache.put(attemptKey,String(failures+1),900);throw apiError_('INVALID_CREDENTIALS','Invalid username or password.')}
