function sessionUser_(token){
  if(!token)throw apiError_('UNAUTHENTICATED','Authentication required.');var hash=digest_(token),now=Date.now(),session=findRow_('Sessions','Session_Token_Hash',hash,true);
  if(!session||session.Status!=='ACTIVE'||session.Revoked_At||new Date(session.Expires_At).getTime()<=now)throw apiError_('SESSION_EXPIRED','Session is invalid or expired.');var staff=findRow_('Staff_List','Staff_ID',session.User_ID,true);if(!staff||staff.Status!=='ACTIVE'||ROLES.indexOf(staff.Role)<0)throw apiError_('FORBIDDEN','Access denied.');
  if(!session.Last_Seen_At||now-new Date(session.Last_Seen_At).getTime()>300000)updateById_('Sessions','Session_ID',session.Session_ID,{Last_Seen_At:now_()});return {staff:staff,session:session};
}
function requireRole_(user,roles){if(roles.indexOf(user.Role)<0)throw apiError_('FORBIDDEN','You do not have permission for this action.')}
